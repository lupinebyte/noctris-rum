{
  "name": "noctris-rum",
  "version": "1.1.0",
  "private": true,
  "description": "Client-side RUM snippet for Noctris \u2014 error, network, and page-load capture.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\""
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vitest": "5.0.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8"
  },
  "license": "UNLICENSED"
}
